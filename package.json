{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "build:container": "next build --webpack",
    "start:container": "node .next/standalone/server.js",
    "test:ci": "node --test tests/rendered-html.test.mjs tests/devsecops.test.mjs",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "test:browser": "node scripts/run-browser-tests.mjs",
    "test:all": "npm test && node scripts/run-browser-tests.mjs --skip-build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.4.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260702.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.3.3",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "postcss": "8.5.32",
    "nanoid": "3.3.18",
    "source-map-js": "1.2.2",
    "sharp": "0.35.5",
    "baseline-browser-mapping": "2.11.34",
    "image-size": "2.0.4",
    "brace-expansion": "1.1.20",
    "undici": "7.30.1",
    "fast-uri": "3.1.7",
    "ws": "8.21.0",
    "js-yaml": "4.3.2",
    "browserslist": "4.28.7"
  }
}
